"Content-Transfer-Encoding: 8bit\n"

msgid "Login failed: check username/password."
msgstr "Falha na autenticação: verifique o utilizador/palavra-passe."

msgid "Logging in…"
msgstr "A autenticar…"

msgid "Checking for duplicate…"
msgstr "A verificar duplicados…"

msgid "Uploading…"
msgstr "A enviar…"

msgid "Adding to shelf…"
msgstr "A adicionar à estante…"

msgid "Send to Calibre-web"
msgstr "Enviar para o Calibre-web"

msgid "Send selected books to Calibre-web server"
msgstr "Enviar os livros selecionados para o servidor Calibre-web"

msgid "No books selected"
msgstr "Nenhum livro selecionado"

msgid "Please select one or more books first."
msgstr "Selecione primeiro um ou mais livros."

msgid "Not configured"
msgstr "Não configurado"

msgid "Please configure the Calibre-web server URL in plugin preferences."
msgstr "Configure o URL do servidor Calibre-web nas preferências do plugin."

msgid "Missing formats"
msgstr "Formatos em falta"

msgid "The following books have no sendable format and will be skipped:"
msgstr "Os seguintes livros não têm um formato enviável e serão ignorados:"

msgid "Continue?"
msgstr "Continuar?"

msgid "Nothing to send"
msgstr "Nada para enviar"

msgid "No books with a suitable format were found."
msgstr "Não foram encontrados livros com um formato adequado."

msgid "Sending \"%s\" to Calibre-web"
msgstr "A enviar \"%s\" para o Calibre-web"

msgid "Queued %d book(s) for Calibre-web"
msgstr "%d livro(s) em fila para o Calibre-web"

msgid "Send failed"
msgstr "Falha no envio"

msgid "An error occurred while sending: %s"
msgstr "Ocorreu um erro ao enviar: %s"

msgid "done"
msgstr "concluído"

msgid "Server URL:"
msgstr "URL do servidor:"

msgid "Username:"
msgstr "Utilizador:"

msgid "Password:"
msgstr "Palavra-passe:"

msgid "Verify SSL certificate:"
msgstr "Verificar certificado SSL:"

msgid "Format preference (comma separated):"
msgstr "Preferência de formatos (separados por vírgula):"

msgid "Add sent books to a shelf:"
msgstr "Adicionar livros enviados a uma estante:"

msgid "empty = use current library name"
msgstr "vazio = usar o nome da biblioteca atual"

msgid "Shelf name:"
msgstr "Nome da estante:"

msgid "Test connection"
msgstr "Testar ligação"

msgid "✗ Enter a server URL first."
msgstr "✗ Introduza primeiro um URL de servidor."

msgid "Testing…"
msgstr "A testar…"

msgid "✓ Connection OK — OPDS catalog reachable."
msgstr "✓ Ligação OK — catálogo OPDS acessível."

msgid "✗ Unexpected status: HTTP %d"
msgstr "✗ Estado inesperado: HTTP %d"

msgid "✗ Authentication failed (HTTP 401) — check username/password."
msgstr "✗ Falha na autenticação (HTTP 401) — verifique o utilizador/palavra-passe."

msgid "✗ Server error: HTTP %d"
msgstr "✗ Erro do servidor: HTTP %d"

msgid "✗ Connection failed: %s"
msgstr "✗ Falha na ligação: %s"

